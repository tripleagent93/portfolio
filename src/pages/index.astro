---
import Layout from '~/layouts/PageLayout.astro';

import ContactUs from '~/components/widgets/Contact.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps from '~/components/widgets/Steps.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import HeadshotImage from '../assets/images/headshot.jpg';
import CreditWiseLandingPageMobile from '../assets/images/creditwise-landing-offset.png';
import EugeneAvatar from '../assets/images/eugene-avatar.png';
import ErvinAvatar from '../assets/images/Ervin-McWilson.png';
import DavidAvatar from '../assets/images/david-k.png';
import IliyaAvatar from '../assets/images/Iliya-Z.png';
import MikeAvatar from '../assets/images/mike-r.png';
import DanAvatar from '../assets/images/dan-s.png';

const metadata = {
  title: 'Max Otkidychev Portfolio Site',
};
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Max Otkidychev"
    tagline="UI/UX DESIGNER / FRONTEND DEVELOPER"
    actions={[{ variant: 'primary', text: 'View My Work', href: '#portfolio' }]}
  >
    <Fragment slot="subtitle">
      I bridge the gap between design and development by building scalable React applications with a strong focus on
      usability, accessibility, and performance. With 6+ years of frontend engineering experience and a Google UX Design
      certification, I transform product ideas into polished, production-ready user experiences.
    </Fragment>
  </Hero>
  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-figma',
        callToAction: {
          target: '_blank',
          text: 'Figma',
          href: 'https://www.figma.com/design/8C149Ck2shVdm5d5HKkt7c/CreditWise?node-id=141-24&t=F3qBTpq6pE3ukny1-1',
        },
      },
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'Github',
          href: 'https://github.com/tripleagent93/credit-wise-mobile-app',
        },
      },
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'LinkedIn',
          href: 'https://www.linkedin.com/in/max-otk/',
        },
      },
    ]}
    image={{
      src: HeadshotImage,
      alt: 'Photo of Max',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2
        class="text-2xl font-bold tracking-tight dark:text-default sm:text-3xl mb-2 motion-safe:opacity-0 motion-safe:intersect:animate-fade"
      >
        About me
      </h2>
      <p class="motion-safe:opacity-0 motion-safe:intersect:animate-fade text-muted">
        I started my career as a frontend developer, but I quickly realized I was just as interested in the user
        experience as I was in the code behind it. I found myself asking why certain interfaces felt intuitive, how
        design decisions influenced behavior, and what made digital products enjoyable to use.
      </p>
      <br />
      <p class="motion-safe:opacity-0 motion-safe:intersect:animate-fade text-muted">
        That curiosity eventually led me into UX design and research, giving me a unique perspective that combines both
        design and engineering. Today, I use that blend of skills to build accessible, scalable React applications that
        balance user needs, business goals, and technical requirements.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="Work experience"
    items={[
      {
        title:
          'Software Engineer <br /> <span class="font-normal">RSI, Roseville, CA</span> <br /> <span class="text-sm font-normal">2018 - Present</span>',
        description: `Developed and maintained React-based internal applications used by enterprise clients
Translated complex business workflows into intuitive, scalable UI systems
Built reusable component libraries to improve development speed and consistency
Improved accessibility and usability across core application flows
Integrated REST APIs and collaborated with backend teams on state-driven features`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Front-End Developer <br /> <span class="font-normal">ASDcom, Sacramento, CA</span> <br /> <span class="text-sm font-normal">2017 - 2018</span>',
        description: `Built responsive frontend interfaces using Vue.js
Translated Figma and Adobe XD designs into production-ready UI components
Improved performance, responsiveness, and cross-browser compatibility
Worked in agile teams alongside designers and developers`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    id="resume"
    title="Education"
    items={[
      {
        title: `Google UX Design Professional Certificate</span> <br /> <span class="text-sm font-normal">2025 - 2026</span>`,
        description: `Focus on user research, wireframing, prototyping, and usability testing.`,
        icon: 'tabler:brand-google',
      },
      {
        title: `B.S. in Computer Science<br /> <span class="font-normal">California State University, Sacramento</span> <br /> <span class="text-sm font-normal">2014 - 2017</span>`,
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Skills"
    subtitle="These are the core skills I use to translate product ideas into scalable, accessible userinterfaces."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Frontend Engineering',
        description:
          'Building scalable, responsive interfaces using modern frontend frameworks and component-driven architecture.',
      },
      {
        title: 'Design Systems',
        description: 'Creating reusable UI systems and scalable component libraries aligned with product consistency.',
      },
      {
        title: 'UX & Accessibility',
        description: 'Designing inclusive, intuitive experiences with accessibility-first frontend development.',
      },
      {
        title: 'Motion & Interaction',
        description: 'Enhancing user experiences through thoughtful animation and interactive feedback.',
      },
      {
        title: 'Performance Optimization',
        description: 'Improving frontend speed and responsiveness through modern optimization techniques.',
      },
      {
        title: 'API Integration & Data Handling',
        description: 'Connecting frontend applications with dynamic data and scalable state management.',
      },
      {
        title: 'Product Thinking & UX Strategy',
        description:
          'Aligning user needs, business goals, and technical constraints to design interfaces that improve usability.',
      },
      {
        title: 'Cross-Functional Collaboration',
        description: 'Bridging the gap between design and engineering to streamline product development.',
      },
      {
        title: 'Research & Prototyping',
        description: 'Transforming user insights into wireframes, prototypes, and validated interface solutions.',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    id="portfolio"
    title="Case Studies"
    subtitle="Explore how I combine deep user research with clean, responsive code to solve real-world problems."
    isReversed
    items={[
      {
        title: 'Description:',
        description:
          'CreditWise is a mobile application concept designed to help users better understand and improve their credit health through personalized insights, goal tracking, and educational content. Created as part of the Google UX Design Professional Certificate, the project focused on simplifying complex financial information into an intuitive and accessible mobile experience.',
      },
      {
        title: 'Role & Contributions:',
        description:
          'Conducted user research, created user flows and information architecture, designed low and high-fidelity wireframes, built interactive prototypes in Figma, developed a reusable component library in Storybook, created a design system.',
      },
      // {
      //   title: 'Tools:',
      //   description: 'Figma • Storybook • React • User Interviews • Usability Testing',
      // },
    ]}
    image={{
      src: CreditWiseLandingPageMobile,
      alt: 'CreditWise Mobile App',
    }}
    callToAction={{
      text: 'View Case Study & Prototype',
      icon: 'tabler:chevron-right',
      href: '/creditwise-mobile-app-case-study',
    }}
    tags={[
      {
        title: 'UX Research',
        slug: 'ux-research',
      },
      {
        title: 'Wireframing',
        slug: 'wireframing',
      },
      {
        title: 'Prototyping',
        slug: 'prototyping',
      },
      {
        title: 'Usability Testing',
        slug: 'usability-testing',
      },
      {
        title: 'Design Systems',
        slug: 'design-systems',
      },
      {
        title: 'Storybook',
        slug: 'storybook',
      },
      {
        title: 'Figma',
        slug: 'figma',
      },
      {
        title: 'React',
        slug: 'react',
      },
    ]}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-default sm:text-3xl mb-2">CreditWise Mobile App</h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

